{
  "name": "harv-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:plant": "node scripts/start-plant.mjs",
    "agent:dev": "node agent/server.mjs",
    "hudson:install": "npm --prefix services/harv-hudson ci",
    "hudson:dev": "node services/harv-hudson/src/main.mjs",
    "test:hudson": "npm --prefix services/harv-hudson test",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:reliability": "tsc -p tsconfig.reliability.json --noEmit && node scripts/run-reliability-tests.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "mqtt": "^5.15.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.25.12"
  }
}
